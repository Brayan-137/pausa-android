<?xml version="1.0" encoding="utf-8"?>
<!-- Ilustración del aviso (Figma "Pop-up: aviso"): tres círculos concéntricos de 200, 160 y 120 dp. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/pausa_circulo_aviso_exterior" />
        </shape>
    </item>
    <item android:bottom="20dp" android:left="20dp" android:right="20dp" android:top="20dp">
        <shape android:shape="oval">
            <solid android:color="@color/pausa_circulo_aviso_anillo" />
        </shape>
    </item>
    <item android:bottom="40dp" android:left="40dp" android:right="40dp" android:top="40dp">
        <shape android:shape="oval">
            <solid android:color="@color/pausa_primario" />
        </shape>
    </item>
</layer-list>
