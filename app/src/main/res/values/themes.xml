<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Pausa" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/pausa_primario</item>
        <item name="colorOnPrimary">@color/pausa_sobre_primario</item>
        <item name="colorPrimaryContainer">@color/pausa_primario_suave</item>
        <item name="colorOnPrimaryContainer">@color/pausa_primario_oscuro</item>
        <item name="android:colorBackground">@color/pausa_fondo</item>
        <item name="colorSurface">@color/pausa_superficie</item>
        <item name="colorOnSurface">@color/pausa_texto</item>
        <item name="colorOnSurfaceVariant">@color/pausa_texto_secundario</item>
        <item name="colorOutline">@color/pausa_borde</item>
        <item name="colorError">@color/pausa_alerta</item>
        <!-- La app siempre usa fondo claro, también con el celular en modo oscuro. -->
        <item name="android:statusBarColor">@color/pausa_fondo</item>
        <item name="android:navigationBarColor">@color/pausa_fondo</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <!-- ===== Pop-up (Figma "Pop-up: ...", 1 nov) ===== -->

    <!-- Botones: 56 dp de alto, esquinas de 16 dp, texto 16sp en negrita media. -->
    <style name="Widget.Pausa.Boton" parent="Widget.Material3.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textAllCaps">false</item>
        <item name="backgroundTint">@color/pausa_primario</item>
        <item name="android:textColor">@color/pausa_sobre_primario</item>
    </style>

    <!-- Relleno azul: Empezar, Sí, Ver opciones, Verificar ahora, Continuar, Llamar, Entendido. -->
    <style name="Widget.Pausa.Boton.Primario" />

    <!-- Blanco con borde azul: No, "Un banco o una entidad". -->
    <style name="Widget.Pausa.Boton.Secundario" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textAllCaps">false</item>
        <item name="backgroundTint">@color/pausa_superficie</item>
        <item name="strokeColor">@color/pausa_primario</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:textColor">@color/pausa_primario</item>
    </style>

    <!-- Rojo suave: "Es una estafa". -->
    <style name="Widget.Pausa.Boton.Alerta" parent="Widget.Pausa.Boton.Secundario">
        <item name="backgroundTint">@color/pausa_alerta_fondo</item>
        <item name="strokeColor">@color/pausa_alerta_borde</item>
        <item name="android:textColor">@color/pausa_alerta</item>
    </style>

    <!-- Blanco con borde claro y texto gris: "Continuar de todos modos". -->
    <style name="Widget.Pausa.Boton.Neutro" parent="Widget.Pausa.Boton.Secundario">
        <item name="strokeColor">@color/pausa_borde_neutro</item>
        <item name="android:textColor">@color/pausa_texto_secundario</item>
    </style>

    <!-- "← Volver": discreto, arriba a la izquierda (no está en el Figma; se conserva para corregir un toque). -->
    <style name="Widget.Pausa.Boton.Volver" parent="Widget.Material3.Button.TextButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">0dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textColor">@color/pausa_texto_secundario</item>
    </style>

    <!-- Textos -->
    <style name="TextoPausa">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center_horizontal</item>
        <item name="android:textColor">@color/pausa_texto</item>
    </style>

    <!-- Títulos grandes centrados (preguntas, consejo, resultados). -->
    <style name="TextoPausa.Titulo">
        <item name="android:textSize">28sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:lineSpacingExtra">4sp</item>
    </style>

    <!-- Texto explicativo gris. -->
    <style name="TextoPausa.Cuerpo">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/pausa_texto_secundario</item>
        <item name="android:lineSpacingExtra">6sp</item>
    </style>

    <!-- "Pregunta 1 de 3" -->
    <style name="TextoPausa.Progreso">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/pausa_texto_tenue</item>
    </style>

    <!-- Contenedor de cada pantalla del pop-up: texto a 32 dp del borde y botones a 24 dp. -->
    <style name="GrupoPausa">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:orientation">vertical</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">24dp</item>
        <item name="android:paddingBottom">24dp</item>
    </style>

    <!-- Zona de contenido con scroll (letra grande del sistema) que deja los botones abajo. -->
    <style name="ContenidoPausa">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:fillViewport">true</item>
        <item name="android:scrollbars">none</item>
    </style>
</resources>
