<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ajustesRaiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pausa_fondo">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        
        <TextView
            android:id="@+id/ajustesTitulo"
            style="@style/PausaTituloPantalla"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ajustes_titulo" />

        <TextView
            style="@style/PausaSeccion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/ajustes_apps" />

        <TextView
            style="@style/PausaTarjetaTexto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/ajustes_apps_texto" />

        <!-- Las filas las crea AjustesActivity cuando termina de leer las apps instaladas. -->
        <LinearLayout
            android:id="@+id/listaApps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_tarjeta"
            android:minHeight="56dp"
            android:orientation="vertical"
            android:paddingTop="4dp"
            android:paddingBottom="4dp" />

        <TextView
            android:id="@+id/textoSinApps"
            style="@style/PausaTarjetaTexto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/ajustes_sin_apps"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnVerTodas"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:minHeight="48dp"
            android:text="@string/ajustes_ver_todas"
            android:textSize="16sp" />

        <TextView
            style="@style/PausaSeccion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/ajustes_ventana" />

        <!-- Una opción por cada valor de AjustesActivity.OPCIONES_MINUTOS, creadas desde el código. -->
        <LinearLayout
            android:id="@+id/opcionesVentana"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal" />

        <TextView
            style="@style/PausaTarjetaTexto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/ajustes_ventana_texto" />

        <TextView
            style="@style/PausaSeccion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/ajustes_contacto" />

        <TextView
            style="@style/PausaTarjetaTexto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/ajustes_contacto_texto" />

        <LinearLayout
            style="@style/PausaTarjeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/textoContacto"
                style="@style/PausaTarjetaTitulo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <Button
                android:id="@+id/btnElegirContacto"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/ajustes_contacto_elegir"
                android:textSize="16sp" />
        </LinearLayout>

        <LinearLayout
            style="@style/PausaTarjeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/PausaTarjetaTitulo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/ajustes_bloqueo" />

                <TextView
                    style="@style/PausaTarjetaTexto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/ajustes_bloqueo_texto" />
            </LinearLayout>

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/interruptorBloqueo"
                style="@style/PausaInterruptor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:contentDescription="@string/ajustes_bloqueo" />
        </LinearLayout>

        <!-- MODO DEMO: oculto hasta tocar 7 toques en la versión, al final. -->
        <LinearLayout
            android:id="@+id/grupoDemo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                style="@style/PausaSeccion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/demo_titulo" />

            <Button
                android:id="@+id/btnProbarPopup"
                style="@style/PausaBoton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/demo_probar_popup" />

            <Button
                android:id="@+id/btnSimularLlamada"
                style="@style/PausaBotonSecundario"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/demo_simular_llamada" />
        </LinearLayout>

        <!-- Como el "Número de compilación" de Android: 7 toques activan o desactivan el modo demo. -->
        <TextView
            android:id="@+id/ajustesVersion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:background="?attr/selectableItemBackground"
            android:gravity="center"
            android:minHeight="48dp"
            android:textColor="@color/pausa_texto_tenue"
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
