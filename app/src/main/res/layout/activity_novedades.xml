<?xml version="1.0" encoding="utf-8"?>
<!-- Novedades al instalar: una sola pantalla que cambia de contenido (sin ViewPager2).
     Estilo azul de la app; "Saltar" arriba a la derecha. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/novedadesRaiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pausa_fondo"
    android:orientation="vertical"
    android:paddingHorizontal="24dp"
    android:paddingBottom="24dp">

    <Button
        android:id="@+id/btnSaltar"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginTop="8dp"
        android:minHeight="48dp"
        android:text="@string/novedades_saltar"
        android:textSize="16sp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="8dp">

            <FrameLayout
                android:layout_width="200dp"
                android:layout_height="200dp"
                android:background="@drawable/bg_novedades_circulo">

                <ImageView
                    android:id="@+id/novedadesIcono"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    tools:src="@drawable/ic_pausa_telefono_colgado" />
            </FrameLayout>

            <TextView
                android:id="@+id/novedadesTitulo"
                style="@style/PausaTituloPantalla"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                tools:text="Pausa te cuida después de una llamada" />

            <TextView
                android:id="@+id/novedadesTexto"
                style="@style/PausaSubtitulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                tools:text="Si cuelgas con un número que no está en tus contactos..." />
        </LinearLayout>
    </ScrollView>

    <!-- 3 puntos de progreso, los pinta NovedadesActivity. -->
    <LinearLayout
        android:id="@+id/novedadesPuntos"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginVertical="16dp"
        android:orientation="horizontal" />

    <Button
        android:id="@+id/btnSiguiente"
        style="@style/PausaBoton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        tools:text="Siguiente" />
</LinearLayout>
