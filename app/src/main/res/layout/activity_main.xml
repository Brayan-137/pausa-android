<?xml version="1.0" encoding="utf-8"?>
<!-- Pantalla TEMPORAL de desarrollo. Julian la reemplaza por la bienvenida (ui/onboarding). -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/main_titulo"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/main_estado_permisos"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textEstado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btnPermisos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/main_pedir_permisos" />

        <Button
            android:id="@+id/btnOverlay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/main_permiso_overlay" />

        <Button
            android:id="@+id/btnUso"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/main_permiso_uso" />

        <Button
            android:id="@+id/btnIniciar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/main_iniciar_servicio" />

        <Button
            android:id="@+id/btnProbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/main_probar_popup" />
    </LinearLayout>
</ScrollView>
