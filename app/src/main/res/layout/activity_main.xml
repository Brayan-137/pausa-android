<?xml version="1.0" encoding="utf-8"?>
<!-- Inicio. Queda invisible hasta saber si la persona ya pasó por la bienvenida. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/inicioRaiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pausa_fondo"
    android:orientation="vertical"
    android:visibility="invisible">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="24dp"
            android:paddingEnd="24dp">

            <TextView
                style="@style/PausaTituloPantalla"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/inicio_titulo" />

            <LinearLayout
                style="@style/PausaTarjeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/textoEstado"
                        style="@style/PausaSeccion"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="20sp" />

                    <TextView
                        android:id="@+id/textoEstadoDetalle"
                        style="@style/PausaTarjetaTexto"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp" />
                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/interruptorProteccion"
                    style="@style/PausaInterruptor"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:contentDescription="@string/inicio_activa" />
            </LinearLayout>

            <!-- Faltan permisos, indispensables o recomendados. Se toca para ir a activarlos. -->
            <LinearLayout
                android:id="@+id/tarjetaPermisos"
                style="@style/PausaTarjeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tarjetaPermisosTitulo"
                    style="@style/PausaTarjetaTitulo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/tarjetaPermisosTexto"
                    style="@style/PausaTarjetaTexto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

            <LinearLayout
                style="@style/PausaTarjeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical">

                <TextView
                    style="@style/PausaTarjetaTexto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/inicio_ultima_alerta" />

                <TextView
                    android:id="@+id/textoUltimaFecha"
                    style="@style/PausaTarjetaTitulo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/textoUltimaDecision"
                    style="@style/PausaTarjetaTexto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/inicio_sin_alertas"
                    android:textColor="@color/pausa_texto" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Entrada destacada al botón de pánico. -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnPanico"
        style="@style/Widget.Pausa.Boton.Panico"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="24dp"
        android:text="@string/inicio_panico" />

    <Button
        android:id="@+id/btnHistorial"
        style="@style/PausaBoton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="24dp"
        android:text="@string/inicio_ver_historial" />

    <Button
        android:id="@+id/btnNumerosOficiales"
        style="@style/PausaBotonSecundario"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="24dp"
        android:text="@string/inicio_numeros_oficiales" />

    <Button
        android:id="@+id/btnConfiguracion"
        style="@style/PausaBotonSecundario"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="24dp"
        android:text="@string/inicio_configuracion" />
</LinearLayout>
