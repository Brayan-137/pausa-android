<?xml version="1.0" encoding="utf-8"?>
<!-- Vista base del pop-up (Brayan). Se muestra encima de otras apps con WindowManager.
     El 26 de octubre se agregan los estados: intro, preguntas, resultado. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/overlayRaiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pausa_velo"
    android:focusable="true"
    android:focusableInTouchMode="true">

    <LinearLayout
        android:id="@+id/overlayTarjeta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_margin="24dp"
        android:background="@color/pausa_fondo"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/overlayTitulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/overlay_titulo"
            android:textColor="@color/pausa_alerta"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/overlayMensaje"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/overlay_mensaje"
            android:textColor="@color/pausa_texto"
            android:textSize="18sp" />

        <!-- Aquí van las preguntas y el consejo (26 y 28 de octubre) -->
        <FrameLayout
            android:id="@+id/overlayContenido"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp" />

        <Button
            android:id="@+id/overlayBtnCerrar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:minHeight="56dp"
            android:text="@string/overlay_cerrar"
            android:textSize="18sp" />
    </LinearLayout>
</FrameLayout>
