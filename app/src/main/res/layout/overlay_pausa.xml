<?xml version="1.0" encoding="utf-8"?>
<!-- Pop-up de Pausa (Brayan). Se muestra encima de otras apps con WindowManager, a pantalla
     completa, siguiendo las pantallas "Pop-up: ..." del Figma de Camilo.
     Un grupo por pantalla; OverlayController muestra uno a la vez:
       aviso -> pregunta (3 o 4 veces) -> consejo -> acciones -> (verificar | estafa)
       aviso -> pregunta (3 veces, todo No) -> todo normal
     Cada grupo: contenido con scroll arriba (letra grande del sistema) y botones abajo. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/overlayRaiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pausa_fondo"
    android:focusable="true"
    android:focusableInTouchMode="true">

    <!-- ========== AVISO (Figma "Pop-up: aviso") ========== -->
    <LinearLayout
        android:id="@+id/overlayGrupoIntro"
        style="@style/GrupoPausa"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ScrollView style="@style/ContenidoPausa">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingHorizontal="8dp"
                android:paddingTop="20dp">

                <FrameLayout
                    android:layout_width="200dp"
                    android:layout_height="200dp"
                    android:background="@drawable/bg_pausa_circulo_aviso">

                    <ImageView
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_pausa_telefono_colgado" />
                </FrameLayout>

                <TextView
                    style="@style/TextoPausa"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:letterSpacing="0.08"
                    android:text="@string/overlay_marca"
                    android:textColor="@color/pausa_popup_oscuro"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    style="@style/TextoPausa.Titulo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="@string/overlay_aviso_titulo"
                    android:textSize="24sp" />

                <TextView
                    android:id="@+id/overlayMensaje"
                    style="@style/TextoPausa.Cuerpo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="64dp"
                    android:paddingHorizontal="6dp"
                    android:text="@string/overlay_mensaje" />
            </LinearLayout>
        </ScrollView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/overlayBtnEmpezar"
            style="@style/Widget.Pausa.Boton.Popup.Primario"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:text="@string/overlay_empezar" />
    </LinearLayout>

    <!-- ========== PREGUNTA (Figma "Pop-up: pregunta" y "Pop-up: ¿quién dijo ser?") ==========
         En "¿Quién dijo ser?" los botones toman el texto de las opciones del JSON. -->
    <LinearLayout
        android:id="@+id/overlayGrupoPregunta"
        style="@style/GrupoPausa"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="8dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/overlayBtnVolver"
                style="@style/Widget.Pausa.Boton.Volver"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_gravity="start|center_vertical"
                android:text="@string/overlay_volver" />

            <TextView
                android:id="@+id/overlayProgreso"
                style="@style/TextoPausa.Progreso"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                tools:text="Pregunta 1 de 3" />
        </FrameLayout>

        <ProgressBar
            android:id="@+id/overlayBarraProgreso"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginHorizontal="8dp"
            android:layout_marginTop="2dp"
            android:importantForAccessibility="no"
            android:max="100"
            android:progressDrawable="@drawable/bg_pausa_progreso"
            tools:progress="33" />

        <ScrollView style="@style/ContenidoPausa">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingHorizontal="8dp"
                android:paddingVertical="24dp">

                <TextView
                    android:id="@+id/overlayPregunta"
                    style="@style/TextoPausa.Titulo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    tools:text="¿Te pidieron transferir, pagar o dar un código?" />
            </LinearLayout>
        </ScrollView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/overlayBtnOpcionA"
            style="@style/Widget.Pausa.Boton.Popup.Primario"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            tools:text="Sí" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/overlayBtnOpcionB"
            style="@style/Widget.Pausa.Boton.Popup.Secundario"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="22dp"
            tools:text="No" />
    </LinearLayout>

    <!-- ========== CONSEJO (Figma "Pop-up: consejo familiar" y "Pop-up: consejo entidad") ==========
         Título = primera frase del consejo del JSON; detalle = el resto. -->
    <LinearLayout
        android:id="@+id/overlayGrupoConsejo"
        style="@style/GrupoPausa"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <ScrollView style="@style/ContenidoPausa">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingHorizontal="8dp"
                android:paddingTop="28dp">

                <!-- Solo para familiar y entidad; en el caso general se oculta. -->
                <TextView
                    android:id="@+id/overlayChipQuien"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:background="@drawable/bg_pausa_chip"
                    android:gravity="center"
                    android:letterSpacing="0.06"
                    android:paddingHorizontal="20dp"
                    android:textColor="@color/pausa_popup_oscuro"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    tools:text="@string/overlay_chip_familiar" />

                <FrameLayout
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/bg_pausa_circulo"
                    android:backgroundTint="@color/pausa_popup_circulo_anillo">

                    <ImageView
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_pausa_telefono"
                        android:tint="@color/pausa_popup_oscuro" />
                </FrameLayout>

                <TextView
                    android:id="@+id/overlayConsejoTitulo"
                    style="@style/TextoPausa.Titulo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="26dp"
                    tools:text="Cuelga y llámale tú al número que tienes guardado" />

                <View
                    android:id="@+id/overlayConsejoDivisor"
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    android:layout_marginTop="40dp"
                    android:background="@color/pausa_borde" />

                <TextView
                    android:id="@+id/overlayConsejoDetalle"
                    style="@style/TextoPausa.Cuerpo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:textSize="14sp"
                    tools:text="Los estafadores usan el miedo y la urgencia para que no verifiques." />
            </LinearLayout>
        </ScrollView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/overlayBtnVerOpciones"
            style="@style/Widget.Pausa.Boton.Popup.Primario"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:text="@string/overlay_ver_opciones" />
    </LinearLayout>

    <!-- ========== ACCIONES (Figma "Pop-up: acciones") ========== -->
    <LinearLayout
        android:id="@+id/overlayGrupoResultado"
        style="@style/GrupoPausa"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <ScrollView style="@style/ContenidoPausa">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingHorizontal="8dp"
                android:paddingTop="28dp">

                <TextView
                    style="@style/TextoPausa.Titulo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/overlay_acciones_titulo"
                    android:textSize="24sp" />

                <TextView
                    style="@style/TextoPausa.Cuerpo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/overlay_acciones_subtitulo"
                    android:textSize="14sp" />

                <FrameLayout
                    android:layout_width="200dp"
                    android:layout_height="200dp"
                    android:layout_marginTop="26dp"
                    android:background="@drawable/bg_pausa_circulo"
                    android:backgroundTint="@color/pausa_popup_circulo_exterior">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:text="\?"
                        android:textColor="@color/pausa_popup_principal"
                        android:textSize="80sp"
                        android:textStyle="bold" />
                </FrameLayout>
            </LinearLayout>
        </ScrollView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/overlayBtnVerificar"
            style="@style/Widget.Pausa.Boton.Popup.Primario"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:text="@string/overlay_verificar" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/overlayBtnEstafa"
            style="@style/Widget.Pausa.Boton.Alerta"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="22dp"
            android:text="@string/overlay_estafa" />

        <!-- Se habilita tras 10 s (cuenta regresiva en el texto del botón). -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/overlayBtnContinuar"
            style="@style/Widget.Pausa.Boton.Popup.Neutro"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="22dp"
            android:text="@string/overlay_continuar_todos_modos" />
    </LinearLayout>

    <!-- ========== TODO NORMAL (Figma "Pop-up: todo normal") ========== -->
    <LinearLayout
        android:id="@+id/overlayGrupoNormal"
        style="@style/GrupoPausa"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <ScrollView style="@style/ContenidoPausa">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingHorizontal="8dp"
                android:paddingVertical="24dp">

                <FrameLayout
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:background="@drawable/bg_pausa_circulo"
                    android:backgroundTint="@color/pausa_exito_brillante">

                    <ImageView
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_pausa_check" />
                </FrameLayout>

                <TextView
                    android:id="@+id/overlayNormalTitulo"
                    style="@style/TextoPausa.Titulo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="30dp"
                    android:textSize="30sp"
                    tools:text="Todo parece normal" />

                <TextView
                    android:id="@+id/overlayNormalDetalle"
                    style="@style/TextoPausa.Cuerpo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:paddingHorizontal="20dp"
                    tools:text="Puedes continuar con lo que ibas a hacer." />
            </LinearLayout>
        </ScrollView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/overlayBtnContinuarNormal"
            style="@style/Widget.Pausa.Boton.Popup.Primario"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:text="@string/overlay_continuar" />
    </LinearLayout>

    <!-- ========== VERIFICAR (Figma "Pop-up: verificar") ==========
         Solo si numeros_oficiales.json tiene entidades con teléfono y fuente; si no, "Verificar
         ahora" abre el marcador directamente. Una tarjeta por entidad (overlay_item_entidad.xml)
         con sus dos botones: "Llamar" y "Abrir página oficial". -->
    <LinearLayout
        android:id="@+id/overlayGrupoVerificar"
        style="@style/GrupoPausa"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/overlayBtnVolverResultado"
            style="@style/Widget.Pausa.Boton.Volver"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginTop="8dp"
            android:text="@string/overlay_volver" />

        <ScrollView style="@style/ContenidoPausa">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="12dp">

                <TextView
                    style="@style/TextoPausa.Titulo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="8dp"
                    android:text="@string/overlay_titulo_verificar" />

                <LinearLayout
                    android:id="@+id/overlayListaEntidades"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:orientation="vertical" />

                <TextView
                    style="@style/TextoPausa.Cuerpo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="30dp"
                    android:paddingHorizontal="40dp"
                    android:text="@string/overlay_verificar_nota" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <!-- ========== ES UNA ESTAFA (Figma "Pop-up: es una estafa") ==========
         Una tarjeta numerada por cada paso de pasos_estafa (overlay_item_paso.xml). -->
    <LinearLayout
        android:id="@+id/overlayGrupoEstafa"
        style="@style/GrupoPausa"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <ScrollView style="@style/ContenidoPausa">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingTop="68dp">

                <FrameLayout
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:background="@drawable/bg_pausa_circulo"
                    android:backgroundTint="@color/pausa_popup_suave">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:text="!"
                        android:textColor="@color/pausa_alerta"
                        android:textSize="44sp"
                        android:textStyle="bold" />
                </FrameLayout>

                <TextView
                    style="@style/TextoPausa.Titulo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="40dp"
                    android:paddingHorizontal="8dp"
                    android:text="@string/overlay_titulo_estafa"
                    android:textSize="30sp" />

                <LinearLayout
                    android:id="@+id/overlayListaPasos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="34dp"
                    android:orientation="vertical" />
            </LinearLayout>
        </ScrollView>

        <!-- Abre PanicoActivity directo en la guía; la decisión del pop-up sigue siendo ESTAFA. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/overlayBtnPanico"
            style="@style/Widget.Pausa.Boton.Alerta"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:text="@string/overlay_ya_transferi" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/overlayBtnEntendido"
            style="@style/Widget.Pausa.Boton.Popup.Primario"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:text="@string/overlay_entendido" />
    </LinearLayout>

    <!-- ========== BLOQUEO EN FRÍO (Figma "Bloqueo en frío") ==========
         Solo si el ajuste "Bloqueo con respiración" está activo: "Continuar de todos modos" lleva aquí. -->
    <LinearLayout
        android:id="@+id/overlayGrupoBloqueo"
        style="@style/GrupoPausa"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <ScrollView style="@style/ContenidoPausa">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingHorizontal="8dp"
                android:paddingTop="28dp">

                <FrameLayout
                    android:layout_width="200dp"
                    android:layout_height="200dp"
                    android:background="@drawable/bg_pausa_circulo_aviso">

                    <ImageView
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_pausa_telefono_colgado" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/bg_panico_chip"
                    android:gravity="center"
                    android:letterSpacing="0.06"
                    android:paddingHorizontal="20dp"
                    android:text="@string/bloqueo_chip"
                    android:textColor="@color/pausa_alerta"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    style="@style/TextoPausa.Titulo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="@string/bloqueo_titulo"
                    android:textSize="26sp" />

                <TextView
                    style="@style/TextoPausa.Cuerpo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/bloqueo_texto" />

                <LinearLayout
                    style="@style/PausaTarjeta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingVertical="24dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/bloqueo_tiempo_restante"
                        android:textColor="@color/pausa_texto_secundario"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/overlayBloqueoTiempo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textColor="@color/pausa_popup_principal"
                        android:textSize="48sp"
                        android:textStyle="bold"
                        tools:text="04:52" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/overlayBtnRespirar"
            style="@style/Widget.Pausa.Boton.Popup.Primario"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            tools:text="Respirar 60 segundos" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/overlayBtnBloqueoVerificar"
            style="@style/Widget.Pausa.Boton.Popup.Secundario"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:text="@string/bloqueo_verificar_ahora" />
    </LinearLayout>

    <!-- ========== RESPIRACIÓN GUIADA (Figma "Respiración guiada") ==========
         INHALA 4 s, SOSTÉN 4 s, EXHALA 6 s; el círculo crece al inhalar y se encoge al exhalar. -->
    <LinearLayout
        android:id="@+id/overlayGrupoRespiracion"
        style="@style/GrupoPausa"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <ScrollView style="@style/ContenidoPausa">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingHorizontal="8dp"
                android:paddingTop="20dp">

                <TextView
                    style="@style/TextoPausa"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.08"
                    android:text="@string/respiracion_marca"
                    android:textColor="@color/pausa_texto_tenue"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="260dp"
                    android:layout_marginTop="12dp">

                    <FrameLayout
                        android:id="@+id/overlayCirculoRespiracion"
                        android:layout_width="240dp"
                        android:layout_height="240dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_pausa_circulo_aviso">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:gravity="center_horizontal"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/overlayFaseNombre"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:letterSpacing="0.08"
                                android:textColor="@color/pausa_popup_suave"
                                android:textSize="13sp"
                                tools:text="INHALA" />

                            <TextView
                                android:id="@+id/overlayFaseSegundos"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/pausa_sobre_primario"
                                android:textSize="40sp"
                                android:textStyle="bold"
                                tools:text="4s" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/respiracion_segundos"
                                android:textColor="@color/pausa_popup_suave"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </FrameLayout>
                </FrameLayout>

                <TextView
                    android:id="@+id/overlayFasePastilla"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_pausa_chip"
                    android:gravity="center"
                    android:minWidth="140dp"
                    android:paddingHorizontal="24dp"
                    android:textColor="@color/pausa_popup_oscuro"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    tools:text="INHALA" />

                <TextView
                    style="@style/TextoPausa.Titulo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/respiracion_titulo"
                    android:textSize="24sp" />

                <TextView
                    style="@style/TextoPausa.Cuerpo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/respiracion_instruccion"
                    android:textSize="14sp" />

                <!-- 5 puntos de progreso, los crea OverlayController. -->
                <LinearLayout
                    android:id="@+id/overlayPuntosRespiracion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:orientation="horizontal" />

                <ProgressBar
                    android:id="@+id/overlayBarraRespiracion"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="6dp"
                    android:layout_marginHorizontal="8dp"
                    android:layout_marginTop="14dp"
                    android:importantForAccessibility="no"
                    android:max="100"
                    android:progressDrawable="@drawable/bg_pausa_progreso" />

                <TextView
                    android:id="@+id/overlayRespiracionRestantes"
                    style="@style/TextoPausa.Progreso"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    tools:text="45 s restantes" />
            </LinearLayout>
        </ScrollView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/overlayBtnSeguir"
            style="@style/Widget.Pausa.Boton.Popup.Primario"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            tools:text="Seguir (45 s)" />
    </LinearLayout>

    <!-- ========== VERIFICAR PARA DESBLOQUEAR (Figma "Verificar para desbloquear") ==========
         "Desbloquear app" se habilita al completar la respiración o al llegar a 0 la cuenta del bloqueo. -->
    <LinearLayout
        android:id="@+id/overlayGrupoDesbloqueo"
        style="@style/GrupoPausa"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <ScrollView style="@style/ContenidoPausa">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingHorizontal="8dp"
                android:paddingTop="28dp">

                <TextView
                    style="@style/TextoPausa.Titulo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/desbloqueo_titulo"
                    android:textSize="26sp" />

                <TextView
                    style="@style/TextoPausa.Cuerpo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/desbloqueo_subtitulo"
                    android:textSize="14sp" />

                <FrameLayout
                    android:layout_width="200dp"
                    android:layout_height="200dp"
                    android:layout_marginTop="24dp"
                    android:background="@drawable/bg_pausa_circulo_aviso">

                    <ImageView
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_pausa_check" />
                </FrameLayout>

                <LinearLayout
                    style="@style/PausaTarjeta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:minHeight="48dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/desbloqueo_respiracion"
                            android:textColor="@color/pausa_texto"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/overlayEstadoRespiracion"
                            style="@style/PausaEtiqueta"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="4dp"
                        android:background="@color/pausa_borde" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:minHeight="48dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/desbloqueo_llamar"
                            android:textColor="@color/pausa_texto"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            style="@style/PausaEtiqueta"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:backgroundTint="@color/pausa_aviso_fondo"
                            android:text="@string/desbloqueo_pendiente"
                            android:textColor="@color/pausa_aviso"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    style="@style/TextoPausa.Cuerpo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:paddingHorizontal="20dp"
                    android:text="@string/desbloqueo_nota"
                    android:textColor="@color/pausa_texto_tenue"
                    android:textSize="13sp" />
            </LinearLayout>
        </ScrollView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/overlayBtnDesbloqueoLlamar"
            style="@style/Widget.Pausa.Boton.Popup.Primario"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:text="@string/desbloqueo_llamar" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/overlayBtnDesbloquear"
            style="@style/Widget.Pausa.Boton.Popup.Neutro"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:text="@string/desbloqueo_desbloquear" />
    </LinearLayout>
</FrameLayout>
